{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ringo Photo Arrangements v1",
  "description": "第二次千问调用输出。同一音乐意图下的 4–8 套四小节编配。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "direction", "bpm", "meter", "barCount", "ticksPerBeat", "tracks"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 48 },
        "direction": { "type": "string", "minLength": 1, "maxLength": 160 },
        "bpm": { "type": "integer", "minimum": 40, "maximum": 240 },
        "meter": { "const": "4/4" },
        "barCount": { "const": 4 },
        "ticksPerBeat": { "const": 480 },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/track" }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "writing", "timbreId", "events"],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 40 },
        "writing": { "type": "string", "minLength": 1, "maxLength": 160 },
        "timbreId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 192,
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startTick", "durationTicks", "midi", "velocity"],
      "properties": {
        "startTick": { "type": "integer", "minimum": 0, "maximum": 7679 },
        "durationTicks": { "type": "integer", "minimum": 1, "maximum": 7680 },
        "midi": { "type": "integer", "minimum": 0, "maximum": 127 },
        "velocity": { "type": "integer", "minimum": 1, "maximum": 127 }
      }
    }
  }
}
